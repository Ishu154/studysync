# StudySync Environment Configuration
PORT=3001
NODE_ENV=development

# Cloud LLM Configuration (OpenAI, OpenRouter, Groq, Ollama, Google AI Studio, etc.)
# Any OpenAI-compatible endpoint with tool calling is supported.
AI_API_KEY=your_llm_api_key_here
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Rate Limiting Controls
AI_MAX_REQUESTS_PER_SOCKET_PER_MIN=5
AI_MAX_REQUESTS_PER_ROOM_PER_MIN=10

